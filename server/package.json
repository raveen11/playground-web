{
  "name": "@kanban/ws-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "test:whiteboard": "pnpm --dir ../shared build && pnpm build && node --test dist/realtime/whiteboard/whiteboard-manager.test.js",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate || exit 0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@kanban/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.40.0",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "multer": "^2.2.0",
    "ollama": "^0.6.3",
    "onnxruntime-web": "^1.27.0",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
