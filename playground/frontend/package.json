{
  "name": "multiplayer-kanban",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --dir ./shared build",
    "dev": "pnpm --parallel --dir ./frontend --dir ./server run dev",
    "dev:frontend": "pnpm --dir ./frontend dev",
    "dev:server": "pnpm --dir ./server dev",
    "build": "pnpm --dir ./shared build && pnpm --dir ./frontend build && pnpm --dir ./server build",
    "build:frontend": "pnpm --dir ./frontend build",
    "build:server": "pnpm --dir ./server build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
